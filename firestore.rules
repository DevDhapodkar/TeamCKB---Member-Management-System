rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && 
             (userData.role.lower() == 'admin' || 
              userData.Admin == true);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isViewerOf(targetUserId) {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && 
             userData.role.lower() == 'viewer' && 
             targetUserId in userData.assignedUserIds;
    }

    function isApproved() {
      let userData = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isAuthenticated() && 
             (userData.approved == true || 
              userData.role.lower() == 'admin' || 
              userData.Admin == true);
    }

    // Users Collection
    match /users/{userId} {
      // Only allow public reading of basic profile info for approved interns/volunteers
      allow read: if (resource.data.approved == true && 
                      resource.data.role.lower() in ['intern', 'volunteer']) || 
                     (isAuthenticated() && (isOwner(userId) || isAdmin() || isViewerOf(userId)));
      allow create: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow update: if isAuthenticated() && (isOwner(userId) || isAdmin());
      allow delete: if isAdmin();
    }

    // Logs Collection
    match /logs/{logId} {
      allow read: if isApproved() && (resource.data.userId == request.auth.uid || isAdmin() || isViewerOf(resource.data.userId));
      allow create: if isApproved();
      allow update, delete: if isApproved() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Contacts Collection
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
  }
}
